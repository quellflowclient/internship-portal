# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# New "publishable" key (sb_publishable_...). Legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key – SERVER ONLY. (SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Form → portal import (same value in Apps Script property PORTAL_IMPORT_SECRET) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMPORT_SECRET=

# --- Google sign-in for local Supabase (supabase/config.jsonc reads these) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
